<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>0.9.1.2</Version>
    <Authors>Wrepsk</Authors>
    <PackageProjectUrl>https://github.com/Wrepsk/crystal-cast</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Wrepsk/crystal-cast.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
    <IsPackable>false</IsPackable>
    <Platforms>x64</Platforms>
    <AssemblyName>CrystalCast</AssemblyName>
    <RootNamespace>CrystalCast</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SupportedOSPlatformVersion>7.0</SupportedOSPlatformVersion>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisMode>Default</AnalysisMode>
    <AllowedReferenceRelatedFileExtensions>.pdb</AllowedReferenceRelatedFileExtensions>
    <CsWinRTIncludesPrivate>Windows.Foundation.TypedEventHandler;Windows.Foundation.FoundationContract;Windows.Foundation.UniversalApiContract;Windows.Foundation.Metadata.ContractVersionAttribute;Windows.Graphics.SizeInt32;Windows.Graphics.DirectX.DirectXPixelFormat;Windows.Graphics.Capture.IDirect3D11CaptureFramePool;Windows.Graphics.Capture.Direct3D11CaptureFramePool</CsWinRTIncludesPrivate>
    <CsWinRTPrivateProjection>true</CsWinRTPrivateProjection>
    <CsWinRTEmbedded>true</CsWinRTEmbedded>
    <CsWinRTAotOptimizerEnabled>false</CsWinRTAotOptimizerEnabled>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CrystalRenderer\CrystalRenderer\CrystalRenderer.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CrystalCast.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\Browser\CommandBridge.js" LogicalName="CrystalCast.BrowserAssets.CommandBridge.js" />
  </ItemGroup>

  <!-- UI fonts from the redesign (SIL OFL). Optional: the UI falls back to Dalamud's fonts when absent. -->
  <ItemGroup>
    <Content Include="Assets\Fonts\*.ttf;Assets\Fonts\*.txt">
      <Link>Assets\Fonts\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.3.1" ExcludeAssets="compile;runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Windows.SDK.Contracts" Version="10.0.17763.1000" PrivateAssets="all" />
    <PackageReference Include="System.Runtime.WindowsRuntime" Version="4.6.0" ExcludeAssets="all" PrivateAssets="all" />
    <PackageReference Include="System.Runtime.WindowsRuntime.UI.Xaml" Version="4.6.0" ExcludeAssets="all" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3967.48" ExcludeAssets="build;buildTransitive;compile;runtime" GeneratePathProperty="true" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Microsoft.Web.WebView2.Core">
      <HintPath>$(PkgMicrosoft_Web_WebView2)\lib_manual\netcoreapp3.0\Microsoft.Web.WebView2.Core.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Content Include="$(PkgMicrosoft_Web_WebView2)\runtimes\win-x64\native\WebView2Loader.dll">
      <Link>WebView2Loader.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </Content>
  </ItemGroup>

  <!-- Experimental Linux/Wine browser helper. The executable is built on Linux
       (native/webkitgtk-host) and is only packaged when it has been built. -->
  <PropertyGroup>
    <WebKitGtkHostBinary>..\native\webkitgtk-host\build\crystalcast-webkit-host</WebKitGtkHostBinary>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(WebKitGtkHostBinary)')">
    <Content Include="$(WebKitGtkHostBinary)">
      <Link>native\linux-x64\crystalcast-webkit-host</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </Content>
    <Content Include="..\native\webkitgtk-host\launch.sh">
      <Link>native\linux-x64\crystalcast-webkit-host.sh</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </Content>
  </ItemGroup>

  <Target Name="RemoveEmbeddedCsWinRTPlatformMarker" AfterTargets="CsWinRTIncludeProjection" BeforeTargets="CoreCompile">
    <ItemGroup>
      <Compile Remove="$(CsWinRTGeneratedFilesDir)Module.cs" />
    </ItemGroup>
  </Target>
</Project>
